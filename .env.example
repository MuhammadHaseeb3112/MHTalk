SECRET_KEY=your-secret-key

DEBUG=True

ALLOWED_HOSTS=127.0.0.1,localhost

# Local Docker uses the DB_* values below. A hosted PostgreSQL (Neon,
# Supabase...) can be given as one URL instead; only postgres:// URLs are used.
# DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require

# Channels layer + cache + rate limits. Hosted Redis: rediss://user:pass@host:port
REDIS_URL=redis://redis:6379

ACCESS_TOKEN_LIFETIME=5

REFRESH_TOKEN_LIFETIME=1


POSTGRES_DB=mhtalk_db
POSTGRES_USER=mhtalk_user
POSTGRES_PASSWORD=replace_with_a_strong_password

DB_ENGINE=django.db.backends.postgresql
DB_NAME=mhtalk_db
DB_USER=mhtalk_user
DB_PASSWORD=replace_with_a_strong_password
DB_HOST=db
DB_PORT=5432

# --- WhatsApp-style messaging rules (optional; defaults shown) ---
# How long after sending a message it can still be edited.
MHTALK_EDIT_WINDOW_MINUTES=15
# How long after sending a message "Delete for everyone" is allowed.
MHTALK_DELETE_FOR_EVERYONE_HOURS=48
# Clear stale "online" flags when the ASGI server starts. Set to 0 when
# running several ASGI workers and run `python manage.py reset_presence`
# once per deploy instead.
MHTALK_RESET_PRESENCE_ON_STARTUP=1

# --- MHTalk AI (assistant chat in the side rail) ---
# FREE: Google Gemini key from https://aistudio.google.com/apikey
#   MHTALK_AI_PROVIDER=gemini
# FREE: Groq key from https://console.groq.com/keys
#   MHTALK_AI_PROVIDER=groq
# Also: openai, anthropic (paid). Leave the key empty to keep AI off.
# Restart the backend after changing these.
MHTALK_AI_PROVIDER=gemini
MHTALK_AI_API_KEY=

# GIFs in the emoji panel (optional, free key from https://developers.giphy.com/dashboard/)
GIPHY_API_KEY=
# Optional: a different model, or an OpenAI-compatible URL.
MHTALK_AI_MODEL=
MHTALK_AI_BASE_URL=

# --- Background (Web Push) notifications ---
# Lets MHTalk notify phones/desktops when no tab is open. Generate a pair
# once with `python manage.py generate_vapid_keys` and keep it forever
# (changing keys invalidates every existing subscription). Leave empty to
# turn background notifications off. VAPID_SUBJECT is a contact for the
# push services: mailto: or https: URL.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# --- Production / deployment (see docs/DEPLOYMENT.md) ---
# Frontend on another domain (Vercel, Cloudflare Pages...):
# CORS_ALLOWED_ORIGINS=https://mhtalk.example.com
# CSRF_TRUSTED_ORIGINS=https://mhtalk.example.com
# Rate limits per minute (login/register use THROTTLE_AUTH):
# THROTTLE_ANON=120/min
# THROTTLE_USER=2000/min
# THROTTLE_AUTH=20/min
# TURN relay for calls (credentials stay on the server):
# TURN_URLS=turn:turn.example.com:3478
# TURN_SECRET=coturn-static-auth-secret
#   ...or a provider's fixed login:
# TURN_USERNAME=
# TURN_PASSWORD=
# Uploads in S3-compatible storage (Cloudflare R2, Backblaze B2, AWS S3):
# USE_S3_MEDIA=True
# S3_BUCKET=
# S3_ENDPOINT_URL=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# Serve /media from Django when DEBUG=False and nothing else serves it:
# MHTALK_SERVE_MEDIA=True
