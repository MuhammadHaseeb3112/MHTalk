# Production settings for docker-compose.prod.yml.
# Copy to .env.prod (in the project root) and fill in. NEVER commit .env.prod.

# Your domain (free options: a DuckDNS subdomain pointing at the server IP).
DOMAIN=chat.example.com
ALLOWED_HOSTS=chat.example.com
CSRF_TRUSTED_ORIGINS=https://chat.example.com
CORS_ALLOWED_ORIGINS=https://chat.example.com

# Generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me
DEBUG=False
SECURE_HSTS_SECONDS=31536000

# Database (created automatically by the db container).
POSTGRES_DB=mhtalk
POSTGRES_USER=mhtalk
POSTGRES_PASSWORD=change-me-strong-password

# Worker processes. Rule of thumb: 2 per CPU core (1 on a 512 MB machine).
WEB_CONCURRENCY=2

# Voice/video call relay (start with: --profile turn). Any long random string.
TURN_SECRET=change-me-long-random-string
TURN_URLS=turn:chat.example.com:3478?transport=udp,turn:chat.example.com:3478?transport=tcp
# Cloud VMs sit behind NAT. Use "public-ip/private-ip" (Oracle: the public IP
# from the instance page, the private one from `hostname -I`). Empty = no NAT.
TURN_EXTERNAL_IP=

# MHTalk AI (optional, free Gemini key from https://aistudio.google.com/apikey)
MHTALK_AI_PROVIDER=gemini
MHTALK_AI_API_KEY=

# Background (Web Push) notifications. Generate once with:
#   docker compose -f docker-compose.prod.yml run --rm web python manage.py generate_vapid_keys --subject mailto:you@example.com
# Keep the same keys forever; empty = background notifications off.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Optional: store uploads in S3-compatible storage instead of the server disk.
# USE_S3_MEDIA=True
# S3_BUCKET=mhtalk-media
# S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# Optional: copy the nightly database backup off the server (deploy/backup.sh)
# with rclone, e.g. oci:mhtalk-backups (Oracle Object Storage, Always Free).
# Empty = backups stay on the server only.
BACKUP_REMOTE=
