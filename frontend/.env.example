# Frontend settings (copy to frontend/.env.local). All are optional.
#
# By default the app calls the backend through the Vite dev proxy
# (/api, /ws and /media are forwarded to http://localhost:8001).
# Set these only when the backend runs on another origin.
# VITE_API_URL=http://localhost:8001/api/
# VITE_WS_URL=ws://localhost:8001
#
# Voice/video calls get their STUN/TURN servers from the backend
# (/api/calls/ice-servers/, configured with TURN_* in the backend .env).
# Local fallback only, if the backend has none configured:
# VITE_TURN_URL=turn:turn.example.com:3478
# VITE_TURN_USER=username
# VITE_TURN_PASS=password
